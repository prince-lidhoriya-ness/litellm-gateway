# context_engineering/ settings (context_engineering/README.md). All optional: empty or unset = the default shown.
# docker-compose.quickstart.yml passes the most common ones through; add others to its environment block as needed.

# ---- the stage ---------------------------------------------------------------------------------------------------
CONTEXT_ENGINEERING_ENABLED=true          # false: the hook passes every request through untouched
CONTEXT_ENGINEERING_MODE=enforce          # shadow: run and report in metadata, forward the original, write no hints
CONTEXT_ENGINEERING_FAIL_MODE=open        # open: forward the original on error/timeout; closed: HTTP 503
CONTEXT_ENGINEERING_TIMEOUT_S=2.0
CONTEXT_ENGINEERING_MIN_TOKENS=1000       # smaller requests skip the stage
CONTEXT_ENGINEERING_LOG_LEVEL=INFO
CONTEXT_HASH_SALT=                        # salt for the conversation key in reports (falls back to OBS_HASH_SALT)

# ---- A. context budget manager -----------------------------------------------------------------------------------
CONTEXT_BUDGET_ENABLED=true
CONTEXT_WINDOW_TOKENS=0                   # 0: max_input_tokens from LiteLLM's model map; >0 overrides for every model
CONTEXT_DEFAULT_WINDOW_TOKENS=32768       # models the map does not know (virtual names such as smart-*)
CONTEXT_MAX_UTILIZATION=0.70              # effective target = this share of the window
CONTEXT_RESERVED_OUTPUT_TOKENS=4096       # output reserve when the request has no max_tokens (at most half the window)
CONTEXT_SAFETY_BUFFER=0.10                # share of the target kept free
# Category shares of the target; a category above its share is "oversized" (a trigger, never a hard cut).
CONTEXT_BUDGET_SHARES=system=0.10,tool_definitions=0.10,history=0.30,tool_output=0.35,retrieved=0.15,current_query=0.30

# ---- C. observation masking --------------------------------------------------------------------------------------
OBSERVATION_MASKING_ENABLED=true
OBSERVATION_DEDUP_ENABLED=true            # fold byte-identical tool outputs into a pointer to the first copy
OBSERVATION_DEDUP_MIN_TOKENS=50
OBSERVATION_MAX_TOKENS=400                # tool outputs larger than this are eligible for masking
OBSERVATION_KEEP_RECENT=3                 # the newest eligible outputs always stay in full
OBSERVATION_MASK_BATCH=4                  # masks advance in steps of this many outputs (prefix-cache stability)
OBSERVATION_ERROR_GUARD=3                 # error outputs among the newest N tool results are never masked
OBSERVATION_STUB_MAX_TOKENS=150
OBSERVATION_HEAD_TAIL_LINES=3
OBSERVATION_MASK_TRIGGER=always           # pressure: mask only when tool outputs are oversized or pressure is high

# ---- store for masked outputs and compacted turns ------------------------------------------------------------------
CONTEXT_STORE=memory                      # memory (per worker) | redis (shared; REDIS_HOST/PORT/PASSWORD) | none
CONTEXT_STORE_TTL_S=3600
CONTEXT_STORE_MAX_ITEMS=2048              # memory store only
CONTEXT_STORE_ALLOW_SENSITIVE=false       # redis only: content with a rules/topic hit is not written unless true
CONTEXT_STORE_REDIS_URL=                  # optional redis://... instead of REDIS_HOST/PORT/PASSWORD

# ---- B. just-in-time retrieval and D. compaction (history under budget pressure) ---------------------------------
CONTEXT_RECENT_TURNS=4                    # the newest user turns are never retrieved, compacted or dropped
JIT_RETRIEVAL_ENABLED=false
JIT_RETRIEVAL_MAX_TURNS=3
JIT_RETRIEVAL_MIN_SCORE=0.0
JIT_RETRIEVAL_BACKEND=bm25                # hybrid: + MiniLM cosine, using the encoder the sensitivity check loads
JIT_RETRIEVAL_ON_CACHING_PROVIDERS=false  # query-dependent selection breaks a provider's cached prefix
CONTEXT_COMPACTION_ENABLED=false
CONTEXT_COMPACTION_THRESHOLD=0.80         # utilization of the target at which history work starts (also: history oversized)
CONTEXT_COMPACTION_BATCH_TURNS=4          # the compacted span grows in steps of this many turns
CONTEXT_COMPACTION_MODE=extractive        # llm: a validated model-written summary replaces it on later requests
CONTEXT_COMPACTION_MODEL=                 # LiteLLM model name for llm mode (keep it local, e.g. obs-priced-llama)
CONTEXT_COMPACTION_MAX_SUMMARY_TOKENS=800
CONTEXT_COMPACTION_MAX_SUMMARY_RATIO=0.70 # a summary this big relative to its span is not used
CONTEXT_COMPACTION_VERBATIM_BLOCK_TOKENS=150

# ---- E. cache-aware prompt construction --------------------------------------------------------------------------
PREFIX_CACHE_OPTIMIZATION_ENABLED=true
PREFIX_CACHE_PROVIDER_SUPPORT=auto        # auto: LiteLLM model map flag; on / off: override for every model
PREFIX_CACHE_FREEZE_HISTORY=auto          # auto: frozen unless the model is known not to cache; always | never
PREFIX_CACHE_INJECT_BREAKPOINTS=true      # Anthropic/Bedrock/Vertex: add cache_control_injection_points
PREFIX_CACHE_BREAKPOINT_MIN_TOKENS=1024
PREFIX_CACHE_RELOCATE_VOLATILE=false      # move date/uuid/request-id lines from the system prompt to the query
PREFIX_CACHE_CANONICAL_TOOLS=false        # sort tool definitions by name
