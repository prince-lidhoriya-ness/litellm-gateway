# Prompt compression pipeline (prompt_compression/). Copy the lines you need into .env.
# Defaults are shown; every variable is optional.

# --- classifier ---
# Hugging Face model id of the zero-shot NLI classifier. Switching models needs no code change.
CLASSIFIER_MODEL=typeform/distilbert-base-uncased-mnli
# "descriptive" (full label descriptions, chosen by the benchmark) or "plain" (label words).
CLASSIFIER_LABEL_FORMAT=descriptive
# "none" or "int8": torch dynamic int8 quantization of the classifier's Linear layers (CPU speed-up).
CLASSIFIER_QUANTIZE=none
# Below this top score the classifier returns "critical", so nothing is lossy-compressed on doubt.
CLASSIFIER_MIN_CONFIDENCE=0.6
# Latency budget per prompt used for model selection (eval/benchmark.py); not enforced at runtime.
CLASSIFIER_LATENCY_BUDGET_MS=300
# Bounded LRU cache of results, keyed by sha256 of the prompt text.
CLASSIFIER_CACHE_SIZE=2048
# Max premise tokens per chunk for long prompts (model window minus hypothesis room).
CLASSIFIER_MAX_CHUNK_TOKENS=400

# --- routing / compression ---
PROMPT_COMPRESSION_ENABLED=true
# open: on any pipeline error send the original prompt and log a warning. closed: reject with HTTP 503.
PROMPT_COMPRESSION_FAIL_MODE=open
# Per-request budget for classify + compress, in seconds.
PROMPT_COMPRESSION_TIMEOUT_S=10
# true: replace detected PII in sensitive messages with placeholders like [EMAIL], [PHONE].
REDACT_SENSITIVE=false
# true: never compress the most recent user message, whatever its label.
PROMPT_COMPRESSION_PRESERVE_LAST_USER=false
# Messages shorter than this many characters are never compressed.
PROMPT_COMPRESSION_MIN_CHARS=200
# LLMLingua-2 checkpoint (same default as ai-features/promptCompression/.../app.py).
PROMPT_COMPRESSION_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
# LLMLingua-2 rate = fraction of tokens kept.
PROMPT_COMPRESSION_RATE_NON_SENSITIVE=0.6
PROMPT_COMPRESSION_RATE_LESS_IMPORTANT=0.3
# Load both models when the proxy starts instead of on the first request.
PROMPT_COMPRESSION_EAGER_LOAD=true
PROMPT_COMPRESSION_LOG_LEVEL=INFO

# --- local verification only (config.yaml mock model) ---
MOCK_LLM_API_BASE=http://127.0.0.1:4010/v1
MOCK_LLM_API_KEY=mock-not-a-secret
