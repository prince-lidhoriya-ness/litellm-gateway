# Prompt compression pipeline (prompt_compression/). Copy the lines you need into .env.
# Defaults are shown; every variable is optional.
#
# Flow: gate -> segment and classify -> router -> keep verbatim | select or drop | compress -> reassemble -> model.
# See prompt_compression/README.md.

# --- gate ---
PROMPT_COMPRESSION_ENABLED=true
# open: on a timeout or any pipeline error send the original prompt and log a warning. closed: reject with HTTP 503.
PROMPT_COMPRESSION_FAIL_MODE=open
# Budget for the whole pipeline per request, in seconds. On a timeout: fail mode.
PROMPT_COMPRESSION_TIMEOUT_S=10
# Requests with fewer text tokens than this skip the pipeline (classifying a tiny prompt costs more than it can save).
PROMPT_COMPRESSION_MIN_TOKENS=50
# enforce: send the compressed prompt. shadow: run everything, log and report what would change, send the ORIGINAL.
# Start in shadow on real traffic before enforcing. A request can opt out with metadata {"prompt_compression": false}.
PROMPT_COMPRESSION_MODE=enforce

# --- segment and classify: sensitivity ---
# A text is sensitive (kept verbatim) when a rules.py rule hits, a topics.py topic hits (health, personal money, legal,
# identity, abuse, employment, non-public company news), or the model's probability reaches SENSITIVITY_THRESHOLD.
# embedding (default): all-MiniLM-L6-v2 + trained head v2 (models/sensitivity_head.json). Held out: test recall 0.973 at
#   a false-positive rate of 0.099, fresh holdout 1.0 at 0.117, company prose 0.0, single qa passages 0.006.
# nli: the earlier zero-shot model below. Test recall 0.973 at a false-positive rate of 0.676 (and 0.79 on company
#   prose), so most ordinary prompts were never compressed. Kept for comparison and rollback.
SENSITIVITY_BACKEND=embedding
# Empty = the backend's default (embedding: the head's cross-validated threshold, 0.36; nli: 0.35).
# Lower = more text kept verbatim, fewer sensitive misses. Retrain/re-measure with eval/train_sensitivity_head.py.
SENSITIVITY_THRESHOLD=
# nli backend only: Hugging Face id of the zero-shot NLI model, label format and quantization.
CLASSIFIER_MODEL=typeform/distilbert-base-uncased-mnli
CLASSIFIER_LABEL_FORMAT=descriptive
CLASSIFIER_QUANTIZE=none
# Latency budget per prompt used for model selection (eval/benchmark.py); not enforced at runtime.
CLASSIFIER_LATENCY_BUDGET_MS=300
# Bounded LRU cache of results, keyed by sha256 of the text.
CLASSIFIER_CACHE_SIZE=2048
# Max premise tokens per chunk for long texts (model window minus hypothesis room).
CLASSIFIER_MAX_CHUNK_TOKENS=400
# A paragraph is "exact text" (never compressed) when this share of its words carries digits, underscores, paths,
# e-mail addresses, camelCase or mid-sentence names.
PROMPT_COMPRESSION_EXACT_DENSITY=0.15

# --- router: which actions are switched on ---
# Comma separated: narrative, passages, records, history.
#   narrative  compress running prose with LLMLingua-2 (code, JSON, logs, tables, identifier-dense text stay verbatim)
#   passages   drop whole passages the question does not need (needs a question in the latest user message)
#   records    drop log / JSON-lines / CSV lines the question does not name
#   history    drop the oldest whole chat turns above PROMPT_COMPRESSION_HISTORY_MAX_TOKENS
# Default: narrative,passages,records. The two selection routes kept accuracy at 1.000 in eval/guard_eval.py and give
# nearly all the savings (benchmark prompts: QA 11% -> 39%, logs 0% -> 66%; reports/playground-ab/REPORT.md).
# Use "narrative" alone for the most conservative behaviour.
PROMPT_COMPRESSION_ROUTES=narrative,passages,records

# --- keep verbatim ---
# true: replace detected PII spans in sensitive blocks with placeholders like [EMAIL], [PHONE] (default: keep them).
REDACT_SENSITIVE=false
# true: never touch the most recent user message.
PROMPT_COMPRESSION_PRESERVE_LAST_USER=false
# true: the first and the last paragraph of the latest user message (instruction and question) are never compressed.
PROMPT_COMPRESSION_PROTECT_EDGES=true

# --- compress text ---
# LLMLingua-2 checkpoint (same default as ai-features/promptCompression/.../app.py).
PROMPT_COMPRESSION_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
# LLMLingua-2 rate = fraction of tokens kept (0.4 gives about 2x on prose in the local calibration). Digits are always kept.
PROMPT_COMPRESSION_RATE=0.4
# Largest ratio (tokens before / after) accepted for one compressed block. A block above it is retried lighter once,
# then left as it was. Research report: 3x for prose.
PROMPT_COMPRESSION_MAX_RATIO=3.0
# Prose runs shorter than this many characters are never compressed.
PROMPT_COMPRESSION_MIN_CHARS=200
# At most this many LLMLingua-2 calls per message (each costs about a second of CPU).
PROMPT_COMPRESSION_MAX_CALLS=6
# Load both models when the proxy starts instead of on the first request.
PROMPT_COMPRESSION_EAGER_LOAD=true

# --- capacity (read by docker-compose.quickstart.yml, not by the pipeline) ---
# Proxy worker processes; each loads its own models (about 1 GB RAM) and runs its model calls one at a time.
# Torch threads per worker. Keep workers x threads = the container's CPUs. Measured on 8 vCPUs, compressed req/s at
# concurrency 8: 1 x 8 = 8.4, 2 x 4 = 12.9, 4 x 2 = 8.7 (evals/REPORT.md).
LITELLM_NUM_WORKERS=2
PROMPT_COMPRESSION_TORCH_THREADS=4

# --- select or drop ---
# passages route: needs at least this many passage blocks holding at least this many tokens; keeps this share of them.
PROMPT_COMPRESSION_MIN_PASSAGES=6
PROMPT_COMPRESSION_MIN_PASSAGE_TOKENS=100
PROMPT_COMPRESSION_PASSAGE_KEEP_RATIO=0.5
# records route: blocks with at least this many lines are candidates; lines kept around each match.
# 100 tokens / 10 lines are the guards eval/guard_eval.py measured quality with; 300 / 20 never fired on typical prompts.
PROMPT_COMPRESSION_RECORD_MIN_LINES=10
PROMPT_COMPRESSION_RECORD_CONTEXT_LINES=1
# history route: 0 = never trim; otherwise trim the oldest whole turns while the prompt exceeds this many tokens,
# always keeping the last PROMPT_COMPRESSION_HISTORY_KEEP_MESSAGES messages and never splitting tool calls from results
# or dropping a turn that contains sensitive text.
PROMPT_COMPRESSION_HISTORY_MAX_TOKENS=0
PROMPT_COMPRESSION_HISTORY_KEEP_MESSAGES=6

PROMPT_COMPRESSION_LOG_LEVEL=INFO

# --- local verification only (config.yaml mock model) ---
MOCK_LLM_API_BASE=http://127.0.0.1:4010/v1
MOCK_LLM_API_KEY=mock-not-a-secret
