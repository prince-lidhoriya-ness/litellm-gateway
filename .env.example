# LiteLLM Gateway Configuration
# Copy this file to .env and fill in your values. docker compose refuses to start while a required value is missing.

# Required: generate each with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-your-random-master-key-here
LITELLM_SALT_KEY=sk-your-random-salt-key-here

# Database (required)
POSTGRES_PASSWORD=your-postgres-password-here

# Server Configuration. LITELLM_BIND defaults to 127.0.0.1: (this machine only); use 0.0.0.0: only behind a TLS proxy.
LITELLM_PORT=4000
LITELLM_BIND=127.0.0.1:
# Container limits for the gateway (each worker holds about 1 GB of models).
# LITELLM_MEM_LIMIT=6g
# LITELLM_CPUS=8

# Project Name
COMPOSE_PROJECT_NAME=litellm-gateway

# Redis (required)
REDIS_PASSWORD=your-redis-password-here

# Langfuse (required: litellm_config.yaml enables the langfuse_otel callback)
# Get from https://cloud.langfuse.com or your self-hosted instance.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxx
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Prompt compression: every PROMPT_COMPRESSION_* / SENSITIVITY_* / CLASSIFIER_* variable is documented in
# prompt_compression.env.example; empty means the code default.

# Observability. OBS_HASH_SALT keys the user/team/message hashes; empty = derived from LITELLM_SALT_KEY.
OBS_HASH_SALT=your-hash-salt-here
OBS_ENABLED=true

# Grafana (only for monitoring/docker-compose.monitoring.yml)
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

# Optional LLM-as-judge (judge-nemotron in litellm_config.yaml)
# OPENROUTER_API_KEY=
