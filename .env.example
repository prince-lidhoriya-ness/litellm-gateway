# LiteLLM Gateway Configuration
# Copy this file to .env and fill in your values

# Required: Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-your-random-master-key-here
LITELLM_SALT_KEY=sk-your-random-salt-key-here

# Database
POSTGRES_PASSWORD=your-postgres-password-here

# Server Configuration
LITELLM_PORT=4000
LITELLM_BIND=127.0.0.1:

# Project Name
COMPOSE_PROJECT_NAME=litellm-gateway

# Redis
REDIS_PASSWORD=your-redis-password-here

# Langfuse (Optional - for observability)
# Get from https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxx
# LANGFUSE_HOST=https://us.cloud.langfuse.com

# Prompt Compression
COMPRESSION_THRESHOLD_CHARS=4000
COMPRESSION_RATE=0.5
COMPRESSION_MODEL=microsoft/llmlingua-2-xlm-roberta-large-meetingbank

# Observability
OBS_HASH_SALT=your-hash-salt-here
OBS_ENABLED=true

# Grafana (Optional)
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here
