# Observability variables (docs/monitoring-plan.md). Put real values in the git-ignored .env.
# Defaults shown; docker-compose.quickstart.yml and monitoring/docker-compose.monitoring.yml read them.

# --- secrets (generate, never commit) ---
# Salt for user/team/message hashes in spans, logs and Langfuse attribution. e.g. openssl rand -hex 32
OBS_HASH_SALT=
# Grafana admin password (user: admin). Required by the monitoring compose.
GRAFANA_ADMIN_PASSWORD=
# Reused from the quickstart .env by the exporters: POSTGRES_PASSWORD, REDIS_PASSWORD.

# --- traces (LiteLLM OTel V2 + OTel SDK) ---
OTEL_EXPORTER=otlp_http
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=litellm-gateway
OTEL_ENVIRONMENT_NAME=local
# Head sampling rate for traces: 1.0 = every request, 0.1 = 10%. Child spans follow the parent decision.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Must stay no_content: prompts/completions never go into span attributes.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=no_content

# --- observability/ callback ---
# false = plain prompt_compression hook (no prompt.* spans, no prompt_pipeline_* metrics, plain logs).
OBS_ENABLED=true
OBS_SERVICE_NAME=litellm-gateway
# OTLP/HTTP logs -> collector -> Loki. Empty = JSON to stdout only.
OBS_OTLP_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
OBS_LOG_JSON=true
# true = attach redacted pre/post-compression text to spans, only for non_sensitive and less_important.
OBS_CAPTURE_TEXT=false
# Cost ESTIMATE for the local classifier + compressor: compute seconds x hourly rate / 3600.
OBS_COMPUTE_DEVICE=cpu
OBS_CPU_HOURLY_RATE_USD=0.10
OBS_GPU_HOURLY_RATE_USD=0
# Distinct values of the `model` metric label before new names collapse to "other".
OBS_MAX_MODEL_LABEL_VALUES=50

# --- verification model (litellm_config.yaml obs-priced-llama) ---
OLLAMA_API_BASE=http://host.docker.internal:11434
