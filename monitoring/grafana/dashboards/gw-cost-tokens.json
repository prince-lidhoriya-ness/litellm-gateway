{
  "uid": "gw-cost-tokens",
  "title": "Gateway - cost and tokens",
  "tags": [
    "litellm",
    "cost"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Spend (24h, USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(litellm_spend_metric_total[24h]))",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "options": {},
      "id": 1
    },
    {
      "type": "stat",
      "title": "Tokens (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(litellm_total_tokens_metric_total[24h]))",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 0
      },
      "options": {},
      "id": 2
    },
    {
      "type": "stat",
      "title": "Tokens saved by compression (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(prompt_pipeline_tokens_saved_total[24h]))",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 12,
        "y": 0
      },
      "options": {},
      "id": 3
    },
    {
      "type": "stat",
      "title": "Local compute cost (24h, ESTIMATE)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(prompt_pipeline_estimated_compute_cost_usd_total[24h]))",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 18,
        "y": 0
      },
      "options": {},
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Spend by model (USD / h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(litellm_spend_metric_total[5m])) * 3600",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 4
      },
      "options": {},
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Spend by team (USD / h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team_alias) (rate(litellm_spend_metric_total[5m])) * 3600",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 4
      },
      "options": {},
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Input / output tokens per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(litellm_input_tokens_metric_total[5m]))",
          "legendFormat": "input {{model}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (model) (rate(litellm_output_tokens_metric_total[5m]))",
          "legendFormat": "output {{model}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 12
      },
      "options": {},
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Prompt tokens before vs after compression",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prompt_pipeline_tokens_before_total[5m]))",
          "legendFormat": "before",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(prompt_pipeline_tokens_after_total[5m]))",
          "legendFormat": "after",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 12
      },
      "options": {},
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Team budget remaining",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "litellm_remaining_team_budget_metric",
          "legendFormat": "{{team_alias}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 20
      },
      "options": {},
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "API key budget remaining",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "litellm_remaining_api_key_budget_metric",
          "legendFormat": "{{hashed_api_key}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 20
      },
      "options": {},
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Budget burn (team, fraction used)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - litellm_remaining_team_budget_metric / (litellm_team_max_budget_metric > 0)",
          "legendFormat": "{{team_alias}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 28
      },
      "options": {},
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Local compute seconds by component",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component) (rate(prompt_pipeline_compute_seconds_total[5m]))",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 28
      },
      "options": {},
      "id": 12
    }
  ],
  "editable": false
}